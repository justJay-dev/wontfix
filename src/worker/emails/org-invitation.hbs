<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1.0" />
        <title>You've been invited</title>
    </head>
    <body
        style="margin:0;padding:0;background-color:#f1f1f1;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;letter-spacing:-0.01em;"
    >
        <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="padding:40px 20px;"
        >
            <tr>
                <td align="center">
                    <!-- Header -->
                    <table
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        style="max-width:480px;"
                    >
                        <tr>
                            <td style="padding:0 0 24px;">
                                <span
                                    style="font-size:18px;font-weight:700;color:#29323d;letter-spacing:-0.02em;"
                                >Your App</span>
                            </td>
                        </tr>
                    </table>
                    <!-- Card -->
                    <table
                        width="100%"
                        cellpadding="0"
                        cellspacing="0"
                        style="max-width:480px;background:#f5f8fa;border-radius:8px;padding:40px;border:1px solid #d4dadb;"
                    >
                        <tr>
                            <td>
                                <h1
                                    style="margin:0 0 12px;font-size:20px;font-weight:600;color:#29323d;"
                                >
                                    You've been invited
                                </h1>
                                <p
                                    style="margin:0 0 28px;font-size:14px;line-height:1.6;color:#29323d;"
                                >
                                    You've been invited to join
                                    <strong>{{organizationName}}</strong>
                                    as a
                                    <strong>{{role}}</strong>. Click the button
                                    below to accept the invitation.
                                </p>
                                <a
                                    href="{{url}}"
                                    style="display:inline-block;padding:12px 24px;background-color:#29323d;color:#ffffff;text-decoration:none;border-radius:6px;font-size:14px;font-weight:500;"
                                >
                                    Accept invitation
                                </a>
                                <p
                                    style="margin:24px 0 0;font-size:12px;color:#6b7280;"
                                >
                                    If you weren't expecting this invitation,
                                    you can safely ignore this email. This
                                    invitation will expire in 48 hours.
                                </p>
                            </td>
                        </tr>
                    </table>
                </td>
            </tr>
        </table>
    </body>
</html>