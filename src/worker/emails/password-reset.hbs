<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset your password</title>
  </head>
  <body
    style="margin:0;padding:0;background-color:#f1f1f1;font-family:Inter,-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;letter-spacing:-0.01em;"
  >
    <table
      width="100%"
      cellpadding="0"
      cellspacing="0"
      style="padding:40px 20px;"
    >
      <tr>
        <td align="center">
          <!-- Header -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="max-width:480px;"
          >
            <tr>
              <td style="padding:0 0 24px;">
                <span
                  style="font-size:18px;font-weight:700;color:#29323d;letter-spacing:-0.02em;"
                >Your App</span>
              </td>
            </tr>
          </table>
          <!-- Card -->
          <table
            width="100%"
            cellpadding="0"
            cellspacing="0"
            style="max-width:480px;background:#f5f8fa;border-radius:8px;padding:40px;border:1px solid #d4dadb;"
          >
            <tr>
              <td>
                <h1
                  style="margin:0 0 12px;font-size:20px;font-weight:600;color:#29323d;"
                >
                  Reset your password
                </h1>
                <p
                  style="margin:0 0 28px;font-size:14px;line-height:1.6;color:#29323d;"
                >
                  We received a request to reset your password. Click the button
                  below to choose a new one.
                </p>
                <table cellpadding="0" cellspacing="0" style="margin:0 0 28px;">
                  <tr>
                    <td style="background-color:#4288c9;border-radius:6px;">
                      <a
                        href="{{url}}"
                        target="_blank"
                        style="display:inline-block;padding:12px 28px;color:#ffffff;font-size:14px;font-weight:500;text-decoration:none;"
                      >
                        Reset password
                      </a>
                    </td>
                  </tr>
                </table>
                <p
                  style="margin:0;font-size:13px;line-height:1.5;color:#7d8283;"
                >
                  If you didn't request this, you can safely ignore this email.
                  The link expires in 1 hour.
                </p>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </body>
</html>
