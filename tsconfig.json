{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["@cloudflare/workers-types", "node", "vite/client"],
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/react-app/src/*"],
      "@worker/*": ["./src/worker/*"],
      "@shared/*": ["./src/shared/*"]
    },
    "outDir": "dist"
  },
  "include": ["src/**/*", "*.config.ts", "worker-configuration.d.ts"],
  "exclude": ["node_modules", "dist", "**/__tests__/**"]
}
